use noise::*;
use macroquad::prelude::*;

#[macroquad::main("Perlin Graph")]
async fn main() {
    let mut t = 0.0;
    let perlin = Perlin::new(1);

    let mut xoff = t;
    let sc_w = screen_width();
    let sc_h = screen_height();

    let prev_y = perlin.get([0.0]) * sc_h as f64;

    loop {
        clear_background(BLACK);

        for i in 0..sc_w as usize {
            let y = perlin.get([xoff]) * sc_h as f64;
            xoff += 0.01;

            draw_line(
                i as f32,
                prev_y as f32,
                i as f32,
                y as f32,
                2.0,
                WHITE,
            );
        }

        t+= 0.01;

        next_frame().await
    }
}
